TELEGRAM_BOT_TOKEN=
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Relative paths are resolved from the project root.
DATABASE_PATH=data/eblangpt.sqlite3
HISTORY_LIMIT=30
CONTEXT_CHAR_LIMIT=8000
AI_MAX_TOKENS=600
MAX_CONCURRENT_REQUESTS=8
GROUP_RANDOM_REPLY_MIN=10
GROUP_RANDOM_REPLY_MAX=20

# Optional image recognition and audio transcription.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_VISION_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
GROQ_API_KEY=
GROQ_TRANSCRIPT_URL=https://api.groq.com/openai/v1/audio/transcriptions
GROQ_TRANSCRIPT_MODEL=whisper-large-v3-turbo
TEXT_FILE_MAX_BYTES=524288
TEXT_FILE_MAX_CHARS=24000
IMAGE_MAX_BYTES=10485760
AUDIO_MAX_BYTES=20971520

# Prefer a permanent numeric ID. Username is a compatibility fallback.
ADMIN_USER_ID=
ADMIN_USERNAME=
START_IMAGE_PATH=assets/eblan.png
GROUP_WELCOME_IMAGE_PATH=assets/eblan-group.png
